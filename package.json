{
  "name": "bakeoff",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "astro dev --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 3000",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "test": "node --experimental-strip-types --import ./tests/register.ts --test tests/*.test.ts",
    "typecheck": "astro check && tsc --noEmit",
    "start": "astro preview --port 3000",
    "test:static": "pnpm build && node --test tests/static/*.test.mjs",
    "measure": "node scripts/measure-build.mjs"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@tailwindcss/vite": "^4.1.18",
    "better-auth": "~1.6.33",
    "convex": "^1.32.0",
    "tailwindcss": "^4.1.18",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "@astrojs/check": "0.9.12"
  }
}
