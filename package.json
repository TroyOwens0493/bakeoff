{
  "name": "budget-together-bakeoff-3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import ./tests/register.ts server/index.ts --dev",
    "start": "node --env-file-if-exists=.env.local --import ./tests/register.ts server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.ts --test tests/*.test.ts",
    "check": "biome check",
    "format": "biome format",
    "lint": "biome lint",
    "measure": "node scripts/measure-build.mjs",
    "test:production": "pnpm build && node --import ./tests/register.ts --test tests/production/*.test.mjs",
    "test:browser": "pnpm build && node --import ./tests/register.ts tests/browser/run.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.10.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
