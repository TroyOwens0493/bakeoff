<div>
 <div class="page-actions"><div class="button-row" data-show="editable"><a class="button secondary" data-edit-category href="/?view=transactions&categoryEdit=new">Manage categories</a><a class="button" data-edit-transaction href="/?view=transactions&edit=new">Add transaction</a></div></div>
 <div data-editor></div>
 <section class="panel table-panel">
  <form method="get" class="filters" data-filters><input type="hidden" name="view" value="transactions"/><input type="hidden" name="space"/><input type="hidden" name="month"/>
   <label class="search-input"><span class="sr-only">Search descriptions and notes</span><input name="search" placeholder="Search transactions"/></label><label><span class="sr-only">Account filter</span><select name="accountId"></select></label><label><span class="sr-only">Category filter</span><select name="categoryId"></select></label><button type="submit">Filter</button>
  </form>
  <div class="table-scroll"><table><thead><tr><th>Date</th><th>Transaction</th><th>Category</th><th>Account</th><th>Amount</th></tr></thead><tbody data-list="transactions"></tbody></table></div>
  <template data-row="transactions"><tr><td data-text="date"></td><td><a class="transaction-button" data-transaction-link></a><small data-text="detail"></small></td><td><span class="tag" data-text="category"></span></td><td data-text="account"></td><td data-text="amount"></td></tr></template>
  <p class="empty-state" data-show="empty">No transactions match these filters.</p>
  <div class="pagination" data-show="pagination"><span><span data-text="total"></span> matching transactions</span><a data-page="first">First page</a><a data-page="next">Next page</a></div>
 </section>
</div>
