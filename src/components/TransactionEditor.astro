---
import Money from "./Money.astro";
import AllocationRow from "./AllocationRow.astro";
---
<section class="panel editor" aria-label="Transaction editor">
 <div class="section-heading"><h2 data-text="title">Transaction details</h2><a data-close-editor href="/?view=transactions">Close</a></div>
 <form data-op="budgets:saveTransaction" data-transform="transaction"><fieldset>
  <label>Account<select name="accountId" required></select><input type="hidden" name="accountId" data-fixed-account disabled/></label>
  <p data-show="noAccount">Connect a bank in Accounts & settings first.</p>
  <label>Description<input name="description" required maxlength="200"/></label><Money name="amount" label="Amount (positive for outflow; negative for income or refund)"/>
  <label>Date<input name="date" type="date" required/></label><p class="muted" data-show="imported">Imported amount, date and pending status are set by the bank. Bank amount: <span data-text="bankAmount"></span>.</p>
  <label>Classification<select name="kind" data-classification><option value="purchase">Purchase or refund</option><option value="income">Income</option><option value="transfer">Transfer or credit card payment</option></select></label>
  <section data-splits><h3>Category splits</h3><div data-rows></div><template data-row-template><AllocationRow split/></template><button type="button" class="secondary" data-add-row>Add split</button><p class="muted">Split amounts must total the transaction amount, including its sign.</p></section>
  <label>Note<textarea name="note" maxlength="2000"></textarea></label><label class="checkbox" data-show="manualPending"><input name="pending" type="checkbox"/>Pending</label>
  <div class="button-row"><button type="submit">Save transaction</button><button type="button" class="danger" data-op="budgets:deleteTransaction" data-show="delete" data-confirm="Delete this manual transaction?">Delete manual entry</button></div><p data-message role="alert"></p>
 </fieldset></form>
 <form class="reconcile" data-op="budgets:reconcile" data-show="reconcile"><h3>Match an imported entry</h3><p>Keep the imported entry and apply this manual entry’s categories and note. The manual entry will stop counting.</p><label>Imported transaction<select name="importId" required></select></label><button type="submit">Match entries</button><p data-message role="alert"></p></form>
</section>
