<div class="app-shell">
 <aside class="sidebar">
  <a class="brand" href="/"><span>b.</span> budget together</a>
  <form method="get"><input type="hidden" name="view"/><input type="hidden" name="month"/>
   <label class="space-select"><span class="eyebrow">YOUR SPACE</span><select name="space" aria-label="Budget space" data-navigate-select></select></label>
  </form>
  <nav aria-label="Main navigation">
   {[["overview","Overview","◫"],["transactions","Transactions","↔"],["budget","Monthly budget","▦"],["review","Monthly review","✓"],["accounts","Accounts & settings","▤"]].map(([id,name,icon])=><a class="nav-item" data-view={id} href={`/?view=${id}`}><span aria-hidden="true">{icon}</span>{name}</a>)}
  </nav>
  <div class="sidebar-bottom"><a class="nav-item" data-view="profile" href="/?view=profile">⚙ Settings</a><button class="nav-item" type="button" data-sign-out>↪ Sign out</button></div>
 </aside>
 <main class="main-content">
  <header class="topbar"><span><span data-text="household"></span> <span class="slash">/</span> <strong data-text="pageName"></strong></span>
   <div><details class="alerts"><summary aria-label="Alerts" data-alert-summary>♧<span class="notification-dot" data-show="unread" hidden></span></summary>
    <section class="panel"><h2>Your alerts</h2><p data-show="noAlerts">No category alerts this month.</p><div data-list="alerts"></div>
     <template data-row="alerts"><div class="alert-row"><p data-text="message"></p><button type="button" class="secondary" data-op="budgets:readAlert">Mark read</button></div></template>
    </section>
   </details>
   <form method="get"><input type="hidden" name="view"/><input type="hidden" name="space"/><label class="month-picker"><span class="sr-only">Reporting month</span><input type="month" name="month" data-navigate-select required/></label></form>
   <span class="avatar" data-text="initials"></span></div>
  </header>
  <p class="banner" data-show="left" hidden>You left this budget. Records shared before you left are available to read.</p>
  <div class="banner" data-live-change hidden role="alert">This page changed. Your unsaved entries are still here. <button type="button" class="secondary" data-reload>Load current values</button></div>
  <div class="save-notice" data-global-message aria-live="polite" hidden></div>
  <div data-view-content></div>
 </main>
</div>
