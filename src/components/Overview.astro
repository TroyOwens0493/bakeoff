---
import Summary from "./Summary.astro";
---
<div>
 <div class="page-actions"><a class="button secondary" data-view="budget" href="/?view=budget">Edit monthly plan</a></div>
 <Summary/>
 <p class="banner" data-show="noPlan" hidden>Start with your monthly plan. Add expected income, category limits, and a savings target.</p>
 <div class="dashboard-grid">
  <section class="panel"><h2>Category balances</h2><div data-list="balances"></div>
   <template data-row="balances"><div class="category-row"><span class="category-icon">◒</span><div class="category-main"><div><strong data-text="name"></strong><small data-text="used"></small></div><div class="progress-track"><div data-progress></div></div></div><div class="category-balance"><strong data-text="left"></strong><small data-text="remaining"></small></div></div></template>
  </section>
  <section class="panel"><div class="section-heading"><h2>Spending over time</h2><form method="get"><input type="hidden" name="space"/><input type="hidden" name="month"/><label><span class="sr-only">Chart category</span><select name="chartCategory" data-navigate-select></select></label></form></div>
   <div class="bar-chart" role="img" aria-label="Monthly spending by category. Refunds extend below zero. Exact values are in the table below." data-chart></div>
   <template data-chart-month><div aria-hidden="true"><div class="spending-bar"><span class="spending-zero"></span></div><small></small></div></template>
   <table class="compact-table"><caption class="sr-only">Monthly spending in US dollars</caption><thead><tr><th>Month</th><th>Spending</th></tr></thead><tbody data-list="reports"></tbody></table>
   <template data-row="reports"><tr><td data-text="month"></td><td data-text="amount"></td></tr></template>
  </section>
 </div>
 <section class="panel activity"><div class="section-heading"><h2>Recent activity</h2><a data-view="transactions" href="/?view=transactions">All transactions →</a></div><div data-list="activity"></div><p class="empty-state" data-show="noActivity">Connect an account to see your activity here.</p>
  <template data-row="activity"><div class="activity-row"><span class="category-icon">↔</span><div><strong data-text="description"></strong><small data-text="detail"></small></div><strong data-text="amount"></strong></div></template>
 </section>
 <section class="panel" data-show="recurring"><h2>Recurring-charge suggestions</h2><p>Estimates from at least three similar monthly charges. No money is moved.</p><div data-list="recurring"></div>
  <template data-row="recurring"><div class="alert-row"><span><strong data-text="merchant"></strong><small data-text="detail"></small></span><div class="button-row"><button type="button" class="secondary" data-status="confirmed" data-op="budgets:setRecurring">Confirm</button><button type="button" class="secondary" data-status="dismissed" data-op="budgets:setRecurring">Dismiss</button></div></div></template>
 </section>
</div>
