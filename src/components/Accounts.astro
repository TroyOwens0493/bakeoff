---
import { type PageData, pageLink } from "../lib/page-data";
import Action from "./Action.astro";
import Contributions from "./Contributions.astro";
interface Props {page: PageData;}
const {page}=Astro.props;
const space=page.space!;
const home=page.home!;
const status=page.sharing;
const destination=home.spaces.find(s=>s.active&&s._id!==space._id);
const hasShared=home.spaces.some(s=>s.type==="shared"&&s.active);
const invite=Astro.url.searchParams.get("invite");
---
<div class="page-actions"><button type="button" data-bank-link disabled={!space.active}>Connect a bank</button></div>
{page.bankReview&&<section class="panel editor"><div class="section-heading"><h2>Check possible duplicate accounts</h2><a href={pageLink(Astro.url,{bankReview:null})}>Close</a></div><p>No transactions will import until you complete this check. A match uses the bank, account type, and last four digits of an account connected by you or your partner.</p><form data-op="bank:confirmAccounts" data-transform="bankReview" data-args={JSON.stringify({id:Astro.url.searchParams.get("bankReview")})}>{page.bankReview.filter(a=>a.possibleDuplicate).map(a=><label>{a.name} · {a.type} · {a.mask}<select name={`decision:${a.accountId}`} required><option value="">Is this an account already connected?</option><option value="same">Same account — keep the existing connection</option><option value="different">Different account — import this account</option></select></label>)}<p>Other selected accounts will import with this connection.</p><button type="submit">Confirm accounts</button><p data-message role="alert"></p></form></section>}
<section class="panel"><h2>Accounts in this budget</h2>{page.accounts?.map(a=><div class="account-row"><div><strong>{a.name}</strong><small>{a.type} · {a.mask} · {a.active?"Current assignment":"Historical records"}</small></div>{space.active&&<div class="account-controls"><details><summary>Rename</summary><form data-op="accounts:rename" data-args={JSON.stringify({id:a._id,revision:a.revision})}><label>Account name<input name="name" value={a.name} required maxlength="100"/></label><button type="submit">Save account name</button><p data-message role="alert"></p></form></details>{a.canMove&&destination&&<details><summary>Move account</summary><p>Only transactions from today onward will be assigned to the destination budget. Earlier records stay in their current budget. Existing private history stays private. Earlier shared history remains available to both partners.</p><p><strong>Destination budget</strong><br/>{destination.name} · {destination.type}</p><Action op="accounts:move" args={{id:a._id,destinationId:destination._id,revision:a.revision}} confirm="Move this account from today onward? Earlier history stays in its original budget.">Confirm account move</Action></details>}</div>}</div>)}{!page.accounts?.length&&<p class="empty-state">No accounts yet. Connect a bank to import transactions automatically.</p>}</section>
<section class="panel"><h2>Your bank connections</h2>{page.connections?.map(c=><div class="connection-row"><div><strong>{c.institution}</strong><small>{c.status} · Last successful import: {c.lastSync?new Date(c.lastSync).toLocaleString("en-US",{timeZone:space.timeZone}):"Not yet"}</small>{c.error&&<p class="over">{c.error}. Imported history is retained.</p>}</div><div class="button-row">{c.status==="review"&&<a class="button" href={pageLink(Astro.url,{bankReview:c._id})}>Review accounts</a>}<Action op="bank:sync" kind="action" args={{id:c._id}} disabled={["disconnected","review","discarding"].includes(c.status)} success="Sync requested. Check the connection status below.">Sync</Action><button type="button" class="secondary" data-bank-link={c._id} disabled={["disconnected","review","discarding"].includes(c.status)}>Reconnect</button><Action op="bank:disconnect" kind="action" args={{id:c._id}} disabled={c.status==="disconnected"} confirm="Disconnect this bank? Imported history will be kept." success="Disconnected. History retained.">Disconnect</Action></div></div>)}{!page.connections?.length&&<p>No bank connections yet.</p>}</section>
{(space.type==="shared"||!hasShared)&&<section class="panel narrow"><h2>Your shared budget</h2>{invite&&<div class="banner"><p>You have an invitation. Accept it with the email address that received the invitation.</p><Action op="sharing:accept" kind="action" args={{token:invite}}>Accept invitation</Action></div>}{space.type==="private"?<><p>You can share one budget with one partner. Each of you has equal control. Your private budget remains separate.</p><Action op="sharing:create" args={{}}>Create shared budget</Action></>:<>
	{space.active&&<Action op="sharing:leave" args={{spaceId:space._id}} class="danger" confirm="Leave this shared budget? Your accounts return to your private budget. The other partner keeps this budget. You keep read access to previously shared records.">Leave shared budget</Action>}
	<p>{status?.members.map(x=>`${x.name}${x.active?"":" (left)"}`).join(" & ")}</p><form data-op="sharing:invite" data-kind="action" data-args={JSON.stringify({spaceId:space._id})} data-success="Invitation queued for email delivery."><label>Partner’s email<input name="email" type="email" required/></label><button type="submit" disabled={!space.active||(status?.members.filter(x=>x.active).length??0)>=2}>Send invitation</button><p data-message role="alert"></p></form>
	{status?.invitations.map(x=><div class="alert-row"><span>{x.email}<small>{x.status} · email {x.delivery} · expires {new Date(x.expiresAt).toLocaleDateString("en-US",{timeZone:space.timeZone})}</small></span>{x.status==="pending"&&<Action op="sharing:revoke" args={{id:x._id}} disabled={!space.active}>Revoke</Action>}</div>)}
</>}</section>}
{page.contributions&&<Contributions page={page}/>}
