<section class="panel editor" role="region" aria-label="Manage categories">
 <div class="section-heading"><h2>Manage categories</h2><a data-close-editor href="/?view=transactions">Close</a></div>
 <form method="get"><input type="hidden" name="view" value="transactions"/><input type="hidden" name="space"/><input type="hidden" name="month"/><label>Category<select name="categoryEdit" data-navigate-select></select></label></form>
 <form data-op="budgets:saveCategory"><fieldset><label>Name<input name="name" required maxlength="100"/></label><label>Color<input type="color" name="color" value="#83aaa2"/></label><button type="submit" data-text="saveLabel">Create category</button><p data-message role="alert"></p></fieldset></form>
 <form class="reconcile" data-op="budgets:deleteCategory" data-show="deleteCategory" data-confirm="Delete this category and reassign its transactions, limits, and carry-forward?"><h3>Delete this category</h3><p>Choose where to move its transactions, plan limits, and carry-forward allocations.</p><label>Replacement<select name="replacementId" required></select></label><button type="submit" class="danger">Delete and reassign</button><p data-message role="alert"></p></form>
</section>
