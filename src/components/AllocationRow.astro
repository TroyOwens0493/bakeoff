---
interface Props { split?: boolean; }
const {split = false}=Astro.props;
---
<div class={split?"split-row":"carry-row"} data-allocation-row>
 <label><span class={split?"sr-only":""}>{split?"Category for split":"Destination"}</span><select name="categoryId" required={split}></select></label>
 <label><span class={split?"sr-only":""}>Amount</span><input name="allocationAmount" value="0.00" inputmode="decimal" required/></label>
 <button type="button" class="text-button" data-remove-row aria-label={split?"Remove split":"Remove allocation"}>×</button>
</div>
