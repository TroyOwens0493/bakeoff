---
import Summary from "./Summary.astro";
import AllocationRow from "./AllocationRow.astro";
---
<div><Summary/>
 <form class="panel" data-op="budgets:review" data-transform="review">
  <div class="review-totals"><div><span>Available to allocate</span><strong data-text="available"></strong></div><div><span>Remaining</span><strong data-review-remaining></strong></div></div>
  <fieldset><div data-rows></div><template data-row-template><AllocationRow/></template><button type="button" class="secondary" data-add-row>Add allocation</button>
   <div class="retained"><span>Keep in <span data-text="month"></span> savings<small>Unassigned savings remain here.</small></span><strong data-review-retained></strong></div>
   <dl><div><dt>Carry forward to <span data-text="nextMonth"></span></dt><dd data-review-reserved></dd></div><div><dt>Original monthly savings result</dt><dd data-text="savings"></dd></div></dl>
   <p class="muted">Reserving funds does not change this month’s income, spending, savings, or target. Late bank corrections can require a new review.</p><p data-show="notSaved">Save this month’s budget before completing its review.</p>
   <button type="submit" data-review-save>Complete monthly review</button><p data-message role="alert"></p>
  </fieldset>
 </form>
</div>
