---
import Page from "../layouts/Page.astro";
import Auth from "../components/Auth.astro";
import Onboarding from "../components/Onboarding.astro";
import BudgetApp from "../components/BudgetApp.astro";
import Overview from "../components/Overview.astro";
import Plan from "../components/Plan.astro";
import Review from "../components/Review.astro";
import Transactions from "../components/Transactions.astro";
import TransactionEditor from "../components/TransactionEditor.astro";
import Categories from "../components/Categories.astro";
import Accounts from "../components/Accounts.astro";
import Contributions from "../components/Contributions.astro";
import Profile from "../components/Profile.astro";
---
<Page>
 <p class="session-status" data-session-status role="status">Checking your session…</p>
 <div data-startup-error class="banner" role="alert" hidden><p data-startup-message></p><button type="button" data-reload>Try again</button></div>
 <div id="app-content"><Auth/></div>
 <noscript><p class="banner">Enable JavaScript to sign in and load your private budget. This page is built in advance; account data loads securely in your browser.</p></noscript>
 <template id="auth-login"><Auth/></template>
 <template id="auth-register"><Auth mode="register"/></template>
 <template id="auth-request"><Auth mode="request"/></template>
 <template id="auth-reset"><Auth mode="reset"/></template>
 <template id="onboarding"><Onboarding/></template>
 <template id="budget-shell"><BudgetApp/></template>
 <template id="view-overview"><Overview/></template>
 <template id="view-budget"><Plan/></template>
 <template id="view-review"><Review/></template>
 <template id="view-transactions"><Transactions/></template>
 <template id="editor-transaction"><TransactionEditor/></template>
 <template id="editor-category"><Categories/></template>
 <template id="view-accounts"><Accounts/></template>
 <template id="view-contributions"><Contributions/></template>
 <template id="view-profile"><Profile/></template>
 <script>import "../scripts/app";</script>
</Page>
