# Copy to .env.local. Use Node 24 or later. Never commit secrets or the database.
PORT=3003
SITE_URL=http://localhost:3003
DATABASE_PATH=./data/bakeoff-3.sqlite
# Optional extra browser origins, such as an SSH tunnel on another port.
AUTH_TRUSTED_ORIGINS=

# Plaid Sandbox only. Required for bank linking and automatic imports.
PLAID_CLIENT_ID=
PLAID_SECRET=
# Base64 encoding of 32 random bytes. Generate once: openssl rand -base64 32
# Keep this key stable, or stored bank tokens cannot be decrypted.
PLAID_TOKEN_ENCRYPTION_KEY=
# Optional approved OAuth redirect URL.
PLAID_REDIRECT_URI=

# Required for invitation and password reset delivery.
RESEND_API_KEY=
RESEND_FROM=Budget Together <budget@your-verified-domain.com>
