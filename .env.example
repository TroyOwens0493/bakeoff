# Local app configuration. Copy to .env.local.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Configure the following on your Convex DEVELOPMENT deployment with `convex env set`.
# These secrets never belong in a VITE_ variable.
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<random secret, at least 32 characters>
# PLAID_CLIENT_ID=<Plaid client ID>
# PLAID_SECRET=<Plaid Sandbox secret>
# PLAID_TOKEN_ENCRYPTION_KEY=<base64 encoding of 32 random bytes>
# PLAID_REDIRECT_URI=<optional approved OAuth redirect URL>
# RESEND_API_KEY=<Resend API key>
# RESEND_FROM=Budget Together <budget@your-verified-domain.com>
